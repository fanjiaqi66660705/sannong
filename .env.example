# ====== LLM 大模型配置（OpenAI 兼容接口）======
# 支持 OpenAI / DeepSeek / Qwen / Kimi 等兼容 OpenAI 格式的接口
# 例如 DeepSeek: https://api.deepseek.com/v1
# 例如 Qwen (通义千问): https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称，例如 deepseek-chat / qwen-plus / gpt-4o-mini
LLM_MODEL=deepseek-chat

# API 密钥（请勿提交到代码仓库，仅在服务端使用）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ====== 问答机器人配置 ======
# 是否在无知识库命中时仍调用大模型生成回答（true/false）
# 设为 false 时，仅基于本地知识库回答，无需 API Key 也能运行演示
CHAT_ALLOW_FALLBACK_LLM=true

# ====== 调研数据分析配置 ======
# 是否使用大模型解析调研文本（true=更智能，false=仅用正则解析）
ANALYZE_USE_LLM=true
